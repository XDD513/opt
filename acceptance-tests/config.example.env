# 复制为 .env 后填写（与 run.mjs 同目录）
# Windows PowerShell: Copy-Item config.example.env .env

BASE_URL=http://localhost:8000

# 普通用户（必填）：用于登录后执行业务接口验收用例
# 勿使用 USERNAME：与 Windows 系统环境变量冲突
TEST_USERNAME=demo_user
TEST_PASSWORD=your_password

# 管理员账号（选填）：若填写则额外执行管理端验收用例（/api/statistics/admin 等）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin_password

# 性能抽样：每个场景连续请求次数（默认 10）
# PERF_ROUNDS=10
