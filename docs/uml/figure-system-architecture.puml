@startuml figure_system_architecture
title 图 医院预约与体质辨识系统 — 系统架构图（分层）

skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei UI"
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFFEF0
  BorderColor #333333
}

top to bottom direction

package "用户层" #E3F2FD {
  actor "普通用户" as A1
  actor "患者" as A2
  actor "管理员" as A3
  usecase "用户界面" as UC_UI
  A1 -down-> UC_UI
  A2 -down-> UC_UI
  A3 -down-> UC_UI
}

package "应用层" #FFF3E0 {
  component "前端模块" as FE <<Module>>
  component "后端模块" as BE <<Module>>
  usecase "技术栈" as UC_TS
  UC_UI -down-> FE
  UC_UI -down-> BE
  FE -down-> UC_TS : Vue 3 组件
  BE -down-> UC_TS : Spring Boot
}

package "技术栈层" #E8F5E9 {
  frame "前端技术" {
    () "Vue.js" as T_VUE
    () "Axios" as T_AXIOS
    [Element Plus] as T_EP
  }
  frame "后端技术" {
    [Spring Boot] as T_SB
    [MyBatis-Plus] as T_MBP
  }
  UC_TS -down-> T_VUE
  UC_TS -down-> T_AXIOS
  UC_TS -down-> T_EP
  UC_TS -down-> T_SB
  UC_TS -down-> T_MBP
}

package "数据层" #FCE4EC {
  database "MySQL数据库" as DB <<Storage>>
  artifact "用户与权限数据" as D_USER
  artifact "预约与业务数据" as D_ORDER
  artifact "体质与健康数据" as D_HEALTH
  artifact "文件存储" as D_FILE
  BE -down-> DB
  T_MBP -down-> DB
  DB -down-> D_USER
  DB -down-> D_ORDER
  DB -down-> D_HEALTH
  DB -down-> D_FILE
}

note bottom of UC_TS
  前端工程基于 Vue 3 + Vite；
  智能舌诊与 LLM 在技术栈图与部署图中展开。
end note

@enduml
